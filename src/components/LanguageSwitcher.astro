---
interface Props {
  currentLang: string;
  translations?: Record<string, string>;
}

const { currentLang, translations } = Astro.props;

const languages: Record<string, { label: string; flag: string }> = {
  en: { label: "EN", flag: "🇺🇸" },
  zh: { label: "中文", flag: "🇨🇳" },
  de: { label: "DE", flag: "🇩🇪" },
  ja: { label: "日本語", flag: "🇯🇵" },
  fr: { label: "FR", flag: "🇫🇷" },
};

// Build the full translation map including current language
const allTranslations: Record<string, string> = { ...translations };
---

{translations && Object.keys(translations).length > 0 && (
  <nav class="language-switcher" aria-label="Language selector">
    {Object.entries(languages).map(([code, { label, flag }]) => {
      const isActive = code === currentLang;
      const slug = isActive ? null : translations?.[code];
      if (!isActive && !slug) return null;
      return isActive ? (
        <span class="lang-btn active">{flag} {label}</span>
      ) : (
        <a href={`/blog/${slug}/`} class="lang-btn" hreflang={code}>
          {flag} {label}
        </a>
      );
    })}
  </nav>
)}

<style>
  .language-switcher {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0;
    justify-content: center;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0.7rem;
    border-radius: 6px;
    font-size: 0.8rem;
    text-decoration: none;
    border: 1px solid rgb(var(--gray-light));
    color: rgb(var(--gray));
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .lang-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(35, 55, 255, 0.05);
  }

  .lang-btn.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
    font-weight: 600;
    cursor: default;
  }
</style>
